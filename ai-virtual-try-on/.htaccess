# AI Virtual Try-On - Apache Configuration
# Disables directory indexing and protects sensitive config files

Options -Indexes

# Protect configuration and environment files from direct browser download
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Recommended PHP settings for image processing
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 128M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 128M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 128M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>
